<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 在 Linux 和 Windows 上仅使用 net10.0，避免缺少 iOS SDK 时触发 NETSDK1147 报错 -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0;net10.0-ios</TargetFrameworks>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>openxmlsdk_native</AssemblyName>

    <!-- 默认版本号为 3.5.1，支持命令行通过 -p:OpenXmlPackageVersion=xxx 动态覆盖 -->
    <OpenXmlPackageVersion Condition="'$(OpenXmlPackageVersion)' == ''">3.5.1</OpenXmlPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="$(OpenXmlPackageVersion)" />
  </ItemGroup>
</Project>
